# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG NODE_IMAGE=node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e

FROM ${NODE_IMAGE} AS build
WORKDIR /workspace
ENV DATABASE_URL=mysql://build:build@127.0.0.1:3306/build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ARG DEBIAN_MIRROR=
ARG DEBIAN_SECURITY_MIRROR=
RUN if [ -n "$DEBIAN_MIRROR" ]; then \
      sed -i "s|https\?://deb.debian.org/debian|$DEBIAN_MIRROR|g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    if [ -n "$DEBIAN_SECURITY_MIRROR" ]; then \
      sed -i "s|https\?://deb.debian.org/debian-security|$DEBIAN_SECURITY_MIRROR|g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates openssl && \
    rm -rf /var/lib/apt/lists/*
RUN corepack enable
ARG PNPM_REGISTRY=https://registry.npmmirror.com
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY common ./common
COPY packages ./packages
COPY backend ./backend
RUN corepack pnpm config set registry "$PNPM_REGISTRY"
RUN --mount=type=cache,id=lingdian-pnpm,target=/pnpm/store \
    corepack pnpm config set store-dir /pnpm/store && \
    corepack pnpm install --frozen-lockfile --fetch-retries=5 --fetch-timeout=120000
RUN corepack pnpm run prisma:generate && corepack pnpm run build:packages && corepack pnpm run build:api

FROM ${NODE_IMAGE}
WORKDIR /workspace
ENV NODE_ENV=production PORT=9000
ARG DEBIAN_MIRROR=
ARG DEBIAN_SECURITY_MIRROR=
RUN if [ -n "$DEBIAN_MIRROR" ]; then \
      sed -i "s|https\?://deb.debian.org/debian|$DEBIAN_MIRROR|g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    if [ -n "$DEBIAN_SECURITY_MIRROR" ]; then \
      sed -i "s|https\?://deb.debian.org/debian-security|$DEBIAN_SECURITY_MIRROR|g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates openssl && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=node:node /workspace /workspace
RUN mkdir -p /workspace/uploads && chown node:node /workspace/uploads
USER node
EXPOSE 9000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD node -e "fetch('http://127.0.0.1:9000/api/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "backend/dist/main.js"]
