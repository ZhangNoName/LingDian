FROM node:24-bookworm-slim AS build
WORKDIR /workspace
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
ARG PNPM_REGISTRY=https://registry.npmmirror.com
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY common ./common
COPY packages ./packages
COPY theme ./theme
COPY admin ./admin
COPY web ./web
COPY uniapp ./uniapp
RUN corepack pnpm config set registry "$PNPM_REGISTRY"
RUN --mount=type=cache,id=lingdian-pnpm,target=/pnpm/store \
    corepack pnpm config set store-dir /pnpm/store && \
    corepack pnpm install --frozen-lockfile --fetch-retries=5 --fetch-timeout=120000
ARG APP
ARG VITE_API_BASE=https://api.zsf.shopping/api
ENV VITE_API_BASE=$VITE_API_BASE
RUN case "$APP" in \
      app) corepack pnpm run build:uniapp && mkdir -p /output && cp -a uniapp/dist/build/h5/. /output/ ;; \
      merchant) corepack pnpm run build:web && mkdir -p /output && cp -a web/dist/. /output/ ;; \
      admin) corepack pnpm run build:admin && mkdir -p /output && cp -a admin/dist/. /output/ ;; \
      *) echo "Unsupported APP=$APP" >&2; exit 2 ;; \
    esac

FROM nginx:1.28-alpine
COPY deploy/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /output/ /usr/share/nginx/html/
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget -qO- http://127.0.0.1/healthz || exit 1
