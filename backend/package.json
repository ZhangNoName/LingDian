{
  "name": "@lingdian/api",
  "version": "0.1.0",
  "private": true,
  "description": "LingDian ordering backend powered by NestJS",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "test": "node --require ts-node/register --test \"src/**/*.spec.ts\"",
    "test:oauth": "node --require ts-node/register --test --test-name-pattern=\"QQ subject|OAuth|PHONE_LINK|state|openid|audits|burn|P2034|bindPending|disabled\" \"src/modules/auth/oauth.service.spec.ts\"",
    "prisma:generate": "pnpm --filter @lingdian/db prisma:generate",
    "prisma:studio": "pnpm --filter @lingdian/db prisma:studio",
    "prisma:format": "pnpm --filter @lingdian/db prisma:format",
    "db:push": "pnpm --filter @lingdian/db db:push",
    "db:pull": "pnpm --filter @lingdian/db db:pull",
    "db:sync-local-config": "node ./scripts/sync-local-config.mjs",
    "db:seed:demo": "node ./scripts/seed-demo-data.mjs",
    "db:seed:auth-bootstrap": "node ./scripts/seed-auth-bootstrap.mjs",
    "db:bootstrap:production": "node ./scripts/bootstrap-production.mjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch"
  },
  "dependencies": {
    "@lingdian/common": "workspace:*",
    "@lingdian/contracts": "workspace:*",
    "@lingdian/db": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prometheus-io/client": "0.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "js-yaml": "^4.3.1",
    "mariadb": "^3.5.3",
    "multer": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^24.7.2",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
