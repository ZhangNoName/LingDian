PORT=9000
API_PREFIX=api
NODE_ENV=development
SWAGGER_ENABLED=true
# allowPublicKeyRetrieval is only appropriate for a trusted local/private MySQL 8.4 network.
DATABASE_MODE=local
DATABASE_URL=mysql://root:password@127.0.0.1:3306/lingdian?allowPublicKeyRetrieval=true
STORE_MODE=single
PRIMARY_STORE_ID=replace-with-the-existing-store-id
# Used only by the idempotent production bootstrap command. A new store defaults
# to CLOSED until STORE_BOOTSTRAP_STATUS is explicitly set to OPEN.
STORE_BOOTSTRAP_CODE=
STORE_BOOTSTRAP_NAME=
STORE_BOOTSTRAP_STATUS=CLOSED
STORE_BOOTSTRAP_CONTACT_NAME=
STORE_BOOTSTRAP_CONTACT_PHONE=
STORE_BOOTSTRAP_ADDRESS=
STORE_BOOTSTRAP_BUSINESS_HOURS=
# Destructive demo reset remains disabled unless explicitly overridden per command.
ALLOW_DEMO_SEED=false
AUTH_JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
AUTH_REFRESH_PEPPER=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
QQ_APP_ID=
QQ_APP_KEY=
QQ_REDIRECT_URI=
QQ_MINI_APP_ID=
QQ_MINI_APP_SECRET=
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
AUTH_BOOTSTRAP_SUPER_ADMIN_USERNAME=
AUTH_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_SUPER_ADMIN_PHONE=
AUTH_BOOTSTRAP_MERCHANT_USERNAME=
AUTH_BOOTSTRAP_MERCHANT_PASSWORD=
AUTH_BOOTSTRAP_MERCHANT_PHONE=
AUTH_BOOTSTRAP_MERCHANT_STORE_IDS=

# Optional integration connector gateways. Every integration has two switches:
# deployment availability here, then a store-level switch through the merchant API.
# Meituan/JD URLs point to an owned connector that translates the neutral LingDian
# event into the current official platform protocol; vendor credentials stay there.
INTEGRATION_CASHIER_ENABLED=false
INTEGRATION_CASHIER_CONNECTOR_URL=
INTEGRATION_CASHIER_SIGNING_SECRET=
INTEGRATION_RECEIPT_ENABLED=false
INTEGRATION_RECEIPT_CONNECTOR_URL=
INTEGRATION_RECEIPT_SIGNING_SECRET=
INTEGRATION_MEITUAN_ENABLED=false
INTEGRATION_MEITUAN_CONNECTOR_URL=
INTEGRATION_MEITUAN_SIGNING_SECRET=
INTEGRATION_JD_ENABLED=false
INTEGRATION_JD_CONNECTOR_URL=
INTEGRATION_JD_SIGNING_SECRET=
# Payment credentials stay in the connector/secret store. The database references only this suffix.
# PAYMENT_CONNECTOR_STORE_1_WECHAT_URL=https://payments.example.com
# PAYMENT_CONNECTOR_STORE_1_WECHAT_SECRET=replace-with-at-least-32-random-characters
