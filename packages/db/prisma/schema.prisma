generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum StoreStatus {
  OPEN
  CLOSED
  RESTING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  ARCHIVED
}

enum ProductType {
  SINGLE
  PACKAGE
}

enum OrderType {
  DINE_IN
  TAKEOUT
  PICKUP
}

enum OrderSource {
  MINIAPP
  MEITUAN_WAIMAI
  JD_DAOJIA
  POS
  MANUAL
}

enum OrderStatus {
  CREATING
  PENDING_PAYMENT
  PAID
  PREPARING
  READY
  COMPLETED
  TIMED_OUT
  REFUNDING
  REFUNDED
  CANCELLED
  FAILED
  DELETED
}

enum PaymentChannel {
  CASH
  WECHAT
  ALIPAY
  UNIONPAY
  STRIPE
  PAYPAL
  CUSTOMER_SCAN
  OTHER
}

enum PaymentProvider {
  WECHAT_PAY
  ALIPAY
  UNIONPAY
  STRIPE
  PAYPAL
}

enum PaymentAccountStatus {
  ACTIVE
  DISABLED
}

enum PaymentIntentStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentTransactionType {
  PAYMENT
  REFUND
  REVERSAL
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentReconciliationStatus {
  PENDING
  MATCHED
  LATE_PAYMENT
  MANUAL_REVIEW
}

enum SelectionGroupType {
  MODIFIER
  COMPONENT
}

enum SelectionMode {
  SINGLE
  MULTIPLE
}

enum SelectionScope {
  PRODUCT
  VARIANT
}

enum IdentityProvider {
  PHONE
  WECHAT
  QQ
  ACCOUNT
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  MERCHANT
}

enum AuthAudience {
  USER_API
  ADMIN_API
  MERCHANT_API
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

enum LegalDocumentType {
  USER_AGREEMENT
  PRIVACY_POLICY
}

enum VerificationPurpose {
  PHONE_LOGIN
  PHONE_LINK
  ADMIN_LOGIN
  PASSWORD_RESET
}

enum SystemLogSource {
  SERVER
  MINIAPP
  MERCHANT_WEB
  ADMIN_WEB
}

enum SystemLogLevel {
  INFO
  WARN
  ERROR
  FATAL
}

enum SystemLogCategory {
  LIFECYCLE
  HTTP
  CLIENT
  SECURITY
}

enum SelectionOptionType {
  VALUE
  VARIANT
}

enum IntegrationProvider {
  CASHIER
  RECEIPT_PRINTER
  MEITUAN_WAIMAI
  JD_DAOJIA
}

enum IntegrationDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  DEAD_LETTER
}

model Store {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String
  contactName         String?
  contactPhone        String?
  address             String?
  businessHours       String?
  status              StoreStatus          @default(OPEN)
  dineInEnabled       Boolean              @default(true)
  takeoutEnabled      Boolean              @default(true)
  pickupEnabled       Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  categories          Category[]
  products            Product[]
  selectionGroups     SelectionGroup[]
  orders              Order[]
  integrations        StoreIntegration[]
  integrationEvents   IntegrationOutbox[]
  paymentAccounts     PaymentAccount[]
  pickupCodeSequences PickupCodeSequence[]

  @@map("stores")
}

model StoreIntegration {
  id        String              @id @default(cuid())
  storeId   String
  provider  IntegrationProvider
  enabled   Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([provider, enabled])
  @@map("store_integrations")
}

model IntegrationOutbox {
  id            String                    @id @default(cuid())
  eventId       String                    @db.VarChar(64)
  provider      IntegrationProvider
  eventType     String                    @db.VarChar(64)
  schemaVersion Int                       @default(1)
  aggregateId   String
  storeId       String
  payload       Json
  status        IntegrationDeliveryStatus @default(PENDING)
  attempts      Int                       @default(0)
  nextAttemptAt DateTime                  @default(now())
  lockedAt      DateTime?
  deliveredAt   DateTime?
  lastError     String?                   @db.VarChar(500)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  store         Store                     @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([provider, eventId])
  @@index([status, nextAttemptAt])
  @@index([storeId, createdAt])
  @@index([aggregateId])
  @@map("integration_outbox")
}

model Category {
  id        String    @id @default(cuid())
  storeId   String
  name      String
  sortOrder Int       @default(0)
  isVisible Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([storeId, sortOrder])
  @@map("categories")
}

model Product {
  id                String                  @id @default(cuid())
  storeId           String
  categoryId        String
  name              String
  description       String?
  imageUrl          String?
  type              ProductType             @default(SINGLE)
  price             Decimal                 @db.Decimal(10, 2)
  status            ProductStatus           @default(DRAFT)
  isFeatured        Boolean                 @default(false)
  stock             Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  store             Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category          Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  skus              ProductSKU[]
  selectionBindings ProductSelectionGroup[]
  orderItems        OrderItem[]

  @@index([storeId, status])
  @@index([categoryId])
  @@map("products")
}

model ProductSKU {
  id                  String                  @id @default(cuid())
  productId           String
  skuName             String
  price               Decimal                 @db.Decimal(10, 2)
  stockCount          Int                     @default(0)
  isDefault           Boolean                 @default(false)
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  product             Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  selectionBindings   ProductSelectionGroup[]
  referencedByOptions SelectionOption[]
  orderItems          OrderItem[]

  @@index([productId])
  @@map("product_skus")
}

model SelectionGroup {
  id              String                  @id @default(cuid())
  storeId         String
  name            String
  groupType       SelectionGroupType
  selectionMode   SelectionMode
  minSelect       Int                     @default(0)
  maxSelect       Int                     @default(1)
  isRequired      Boolean                 @default(false)
  isActive        Boolean                 @default(true)
  sortOrder       Int                     @default(0)
  description     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  store           Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  options         SelectionOption[]
  productBindings ProductSelectionGroup[]

  @@index([storeId, sortOrder])
  @@map("selection_groups")
}

model SelectionOption {
  id              String               @id @default(cuid())
  groupId         String
  name            String
  optionType      SelectionOptionType  @default(VALUE)
  priceDelta      Decimal              @default(0) @db.Decimal(10, 2)
  stockDelta      Int                  @default(0)
  isDefault       Boolean              @default(false)
  isActive        Boolean              @default(true)
  sortOrder       Int                  @default(0)
  referencedSkuId String?
  extraData       Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  group           SelectionGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  referencedSku   ProductSKU?          @relation(fields: [referencedSkuId], references: [id], onDelete: SetNull)
  orderSelections OrderItemSelection[]

  @@index([groupId, sortOrder])
  @@index([referencedSkuId])
  @@map("selection_options")
}

model ProductSelectionGroup {
  id        String         @id @default(cuid())
  productId String?
  variantId String?
  groupId   String
  scope     SelectionScope
  sortOrder Int            @default(0)
  isEnabled Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  product   Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductSKU?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  group     SelectionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
  @@index([groupId])
  @@map("product_selection_groups")
}

model Order {
  id                 String           @id @default(cuid())
  orderNo            String           @unique
  storeId            String
  customerUserId     String?
  clientRequestId    String?          @db.VarChar(64)
  customerName       String
  customerMobile     String
  deliveryAddress    String?          @db.Text
  orderType          OrderType
  orderSource        OrderSource      @default(MINIAPP)
  pickupCode         String?          @db.VarChar(16)
  pickupBusinessDate DateTime?        @db.Date
  status             OrderStatus      @default(CREATING)
  paymentChannel     PaymentChannel   @default(CASH)
  totalAmount        Decimal          @db.Decimal(10, 2)
  payableAmount      Decimal          @db.Decimal(10, 2)
  remark             String?
  isDeleted          Boolean          @default(false)
  deletedAt          DateTime?
  paidAt             DateTime?
  cancelledAt        DateTime?
  refundingAt        DateTime?
  refundedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  store              Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customerUser       User?            @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  statusLogs         OrderStatusLog[]
  paymentIntents     PaymentIntent[]

  @@unique([storeId, customerUserId, clientRequestId])
  @@unique([storeId, pickupBusinessDate, pickupCode])
  @@index([storeId, createdAt])
  @@index([customerUserId, createdAt])
  @@index([status])
  @@index([isDeleted, createdAt])
  @@index([storeId, status, isDeleted])
  @@map("orders")
}

model PickupCodeSequence {
  id           String      @id @default(cuid())
  storeId      String
  businessDate DateTime    @db.Date
  orderSource  OrderSource
  lastValue    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, businessDate, orderSource])
  @@map("pickup_code_sequences")
}

/// A store-owned receiving account. Credentials and private keys are never stored here;
/// connectorConfigKey resolves them from the deployment secret store.
model PaymentAccount {
  id                 String                @id @default(cuid())
  storeId            String
  provider           PaymentProvider
  channel            PaymentChannel
  externalAccountId  String                @db.VarChar(191)
  connectorConfigKey String                @db.VarChar(64)
  status             PaymentAccountStatus  @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  store              Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  paymentIntents     PaymentIntent[]
  webhookEvents      PaymentWebhookEvent[]

  @@unique([storeId, provider, channel])
  @@index([provider, status])
  @@map("payment_accounts")
}

model PaymentIntent {
  id                   String                      @id @default(cuid())
  paymentNo            String                      @unique @db.VarChar(64)
  orderId              String
  accountId            String
  provider             PaymentProvider
  channel              PaymentChannel
  status               PaymentIntentStatus         @default(CREATED)
  reconciliationStatus PaymentReconciliationStatus @default(PENDING)
  amountMinor          BigInt
  currency             String                      @default("CNY") @db.Char(3)
  clientRequestId      String                      @db.VarChar(64)
  providerIntentId     String?                     @db.VarChar(191)
  clientAction         Json?
  failureCode          String?                     @db.VarChar(64)
  failureMessage       String?                     @db.VarChar(255)
  expiresAt            DateTime
  paidAt               DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  order                Order                       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  account              PaymentAccount              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transactions         PaymentTransaction[]

  @@unique([orderId, clientRequestId])
  @@unique([provider, providerIntentId])
  @@index([orderId, createdAt])
  @@index([status, expiresAt])
  @@index([accountId], map: "payment_intents_accountId_fkey")
  @@map("payment_intents")
}

model PaymentTransaction {
  id                    String                   @id @default(cuid())
  transactionNo         String                   @unique @db.VarChar(64)
  paymentIntentId       String
  type                  PaymentTransactionType
  status                PaymentTransactionStatus
  amountMinor           BigInt
  currency              String                   @db.Char(3)
  providerTransactionId String?                  @db.VarChar(191)
  idempotencyKey        String                   @db.VarChar(191)
  failureCode           String?                  @db.VarChar(64)
  occurredAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  paymentIntent         PaymentIntent            @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@unique([paymentIntentId, type, idempotencyKey])
  @@unique([paymentIntentId, providerTransactionId])
  @@index([paymentIntentId, createdAt])
  @@map("payment_transactions")
}

model PaymentWebhookEvent {
  id                String          @id @default(cuid())
  provider          PaymentProvider
  accountId         String
  eventId           String          @db.VarChar(191)
  eventType         String          @db.VarChar(64)
  payloadHash       String          @db.Char(64)
  signatureVerified Boolean         @default(false)
  processedAt       DateTime?
  processingError   String?         @db.VarChar(255)
  createdAt         DateTime        @default(now())
  account           PaymentAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([provider, accountId, eventId])
  @@index([processedAt, createdAt])
  @@index([accountId], map: "payment_webhook_events_accountId_fkey")
  @@map("payment_webhook_events")
}

model OrderStatusLog {
  id           String       @id @default(cuid())
  orderId      String
  fromStatus   OrderStatus?
  toStatus     OrderStatus
  operatorName String?
  note         String?
  extra        Json?
  createdAt    DateTime     @default(now())
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_logs")
}

model OrderItem {
  id          String               @id @default(cuid())
  orderId     String
  productId   String
  skuId       String?
  productName String
  skuName     String?
  unitPrice   Decimal              @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal              @db.Decimal(10, 2)
  remark      String?
  createdAt   DateTime             @default(now())
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku         ProductSKU?          @relation(fields: [skuId], references: [id], onDelete: Restrict)
  selections  OrderItemSelection[]

  @@index([orderId])
  @@index([productId])
  @@index([skuId])
  @@map("order_items")
}

model OrderItemSelection {
  id                 String              @id @default(cuid())
  orderItemId        String
  selectionGroupId   String?
  selectionOptionId  String?
  groupNameSnapshot  String
  optionNameSnapshot String
  optionType         SelectionOptionType
  referencedSkuId    String?
  referencedSkuName  String?
  priceDelta         Decimal             @default(0) @db.Decimal(10, 2)
  quantity           Int                 @default(1)
  createdAt          DateTime            @default(now())
  orderItem          OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  selectionOption    SelectionOption?    @relation(fields: [selectionOptionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([selectionOptionId])
  @@map("order_item_selections")
}

model User {
  id                 String               @id @default(cuid())
  nickname           String?              @db.VarChar(32)
  avatarData         Bytes?               @db.MediumBlob
  avatarMimeType     String?              @db.VarChar(32)
  status             UserStatus           @default(ACTIVE)
  sessionVersion     Int                  @default(1)
  lastLoginAt        DateTime?
  mustChangePassword Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  identities         AuthIdentity[]
  roles              UserRoleAssignment[]
  sessions           AuthSession[]
  addresses          UserAddress[]
  legalConsents      UserLegalConsent[]
  orders             Order[]

  @@map("users")
}

model UserLegalConsent {
  id           String            @id @default(cuid())
  userId       String
  documentType LegalDocumentType
  version      String            @db.VarChar(32)
  acceptedAt   DateTime          @default(now())
  ip           String?           @db.VarChar(64)
  device       String?           @db.VarChar(191)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, version])
  @@index([userId, acceptedAt])
  @@map("user_legal_consents")
}

model UserAddress {
  id            String   @id @default(cuid())
  userId        String
  recipientName String   @db.VarChar(64)
  phoneNumber   String   @db.VarChar(32)
  provinceName  String   @db.VarChar(64)
  cityName      String   @db.VarChar(64)
  countyName    String   @db.VarChar(64)
  streetName    String   @db.VarChar(128)
  detailInfo    String   @db.VarChar(255)
  postalCode    String   @default("") @db.VarChar(16)
  nationalCode  String   @default("") @db.VarChar(16)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@index([userId, updatedAt])
  @@map("user_addresses")
}

model AuthIdentity {
  id                 String              @id @default(cuid())
  userId             String
  provider           IdentityProvider
  subject            String
  accountName        String?             @unique @db.VarChar(191)
  phoneE164          String?
  verifiedAt         DateTime?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordCredential PasswordCredential?

  @@unique([provider, subject])
  @@unique([phoneE164])
  @@index([userId])
  @@map("auth_identities")
}

model PasswordCredential {
  id                String       @id @default(cuid())
  identityId        String       @unique
  passwordHash      String       @db.Text
  passwordChangedAt DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  identity          AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model UserRoleAssignment {
  id        String     @id @default(cuid())
  userId    String
  role      UserRole
  scopeType String     @default("GLOBAL")
  scopeId   String     @default("")
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scopeType, scopeId])
  @@index([userId, status])
  @@map("user_roles")
}

model AuthSession {
  id                       String        @id @default(cuid())
  userId                   String
  audience                 AuthAudience
  refreshTokenHash         String        @unique
  previousRefreshTokenHash String?       @unique
  refreshTokenHistory      Json?
  device                   String
  status                   SessionStatus @default(ACTIVE)
  expiresAt                DateTime
  revokedAt                DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  user                     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, audience, device])
  @@index([userId, status])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model VerificationCode {
  id         String              @id @default(cuid())
  purpose    VerificationPurpose
  targetHash String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([purpose, targetHash, expiresAt])
  @@index([expiresAt])
  @@map("verification_codes")
}

model PendingOAuth {
  id                        String           @id @default(cuid())
  provider                  IdentityProvider
  subject                   String
  stateHash                 String           @unique
  audience                  AuthAudience
  providerMetadataEncrypted String           @db.Text
  expiresAt                 DateTime
  consumedAt                DateTime?
  createdAt                 DateTime         @default(now())

  @@index([provider, subject])
  @@index([expiresAt])
  @@map("pending_oauth")
}

model AuthAuditLog {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  sessionId String?
  ip        String?
  device    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([event, createdAt])
  @@map("auth_audit_logs")
}

model SystemLog {
  id         String            @id @default(cuid())
  source     SystemLogSource
  level      SystemLogLevel
  category   SystemLogCategory
  event      String            @db.VarChar(64)
  message    String            @db.VarChar(512)
  requestId  String?           @db.VarChar(64)
  userId     String?           @db.VarChar(191)
  method     String?           @db.VarChar(16)
  path       String?           @db.VarChar(256)
  statusCode Int?
  ip         String?           @db.VarChar(64)
  details    Json?
  createdAt  DateTime          @default(now())

  @@index([source, level, createdAt])
  @@index([event, createdAt])
  @@index([createdAt])
  @@map("system_logs")
}
