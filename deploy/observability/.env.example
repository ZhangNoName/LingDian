# 所有管理界面仅绑定回环地址，请通过 SSH 隧道访问。
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
# Used only to reject accidental port collisions with the core services.
CORE_API_PORT=9000
CORE_APP_PORT=8082
CORE_MERCHANT_PORT=8083
CORE_ADMIN_PORT=8084
LINGDIAN_NETWORK=lingdian
# Dashboard 与告警仅支持 lingdian、lingdian-* 或 lingdian_* 项目名。
CORE_COMPOSE_PROJECT_NAME=lingdian
# Ubuntu/Debian 的 adm 组默认 GID；其他系统用 `getent group adm` 确认。
NGINX_LOG_GROUP_GID=4

# 生产环境请设置为 release 目录之外的绝对路径，例如 /opt/lingdian/observability。
# 留空时使用当前 checkout 下被 Git 忽略的 generated/，仅适合本地开发。
OBSERVABILITY_STATE_DIR=

# 指标、日志和告警历史保留期及 Prometheus 最大磁盘占用。
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=20GB
LOKI_RETENTION=336h
ALERTMANAGER_RETENTION=120h

# 默认总内存上限约 3 GiB；8 GiB 服务器可与核心服务共存。
# 低配机器可调低，但 Prometheus/Loki 可能 OOM 或丢失采集数据。
PROMETHEUS_MEMORY_LIMIT=768m
LOKI_MEMORY_LIMIT=768m
GRAFANA_MEMORY_LIMIT=512m
ALLOY_MEMORY_LIMIT=256m
CADVISOR_MEMORY_LIMIT=256m
ALERTMANAGER_MEMORY_LIMIT=128m
NODE_EXPORTER_MEMORY_LIMIT=128m
BLACKBOX_MEMORY_LIMIT=64m
SOCKET_PROXY_MEMORY_LIMIT=64m

# 安装前置检查；低于阈值默认停止，可显式设为 true 仅跳过容量门禁。
MIN_HOST_MEMORY_GB=8
MIN_FREE_DISK_GB=40
ALLOW_LOW_RESOURCES=false

# 公网合成探测目标；留空的 URL 不会写入探测配置。
PUBLIC_APP_URL=https://app.zsf.shopping/
PUBLIC_MERCHANT_URL=https://merchant.zsf.shopping/
PUBLIC_ADMIN_URL=https://admin.zsf.shopping/
PUBLIC_API_READY_URL=https://api.zsf.shopping/api/health/ready

# 可选：接收 Alertmanager JSON POST 的 HTTPS webhook。
ALERT_WEBHOOK_URL=
