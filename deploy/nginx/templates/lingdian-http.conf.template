server {
    listen 80;
    listen [::]:80;
    server_name __API_DOMAIN__;
    client_max_body_size 20m;
    access_log /var/log/lingdian/nginx/access.log lingdian_json;
    error_log /var/log/lingdian/nginx/error.log warn;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ { root /var/www/lingdian-acme; }
    location ~* ^/api/metrics(?:/|$) { return 404; }
    location / { return 503; }
