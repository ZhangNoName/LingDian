# -----------------------------------------------------------------------------
# LingDian production configuration
# Copy with: bash deploy/scripts/init-env.sh
# Keep the resulting file outside the repository and chmod 0600.
# -----------------------------------------------------------------------------

# Deployment paths and release policy
DEPLOY_ROOT=/opt/lingdian
DATA_DIR=/opt/lingdian/data
BACKUP_DIR=/opt/lingdian/backups
RELEASES_DIR=/opt/lingdian/releases
STATE_DIR=/opt/lingdian/state
COMPOSE_PROJECT_NAME=lingdian
COMPOSE_NETWORK=lingdian
DATABASE_MODE=local
BACKUP_ON_DEPLOY=true
BACKUP_RETENTION_DAYS=14
RELEASE_RETENTION_COUNT=5
AUTO_CLEANUP_RELEASES=true
AUTO_ROLLBACK=true
SCRUB_BOOTSTRAP_CREDENTIALS=true
TLS_ENABLED=true
TLS_STAGING=false
OBSERVABILITY_ENABLED=true
# Optional Alertmanager JSON webhook. Leave empty to keep alerts only in the UI.
ALERT_WEBHOOK_URL=
TZ=Asia/Shanghai

# Public endpoints. All four DNS records must point to this server.
DEPLOY_PUBLIC_IPV4=CHANGE_ME_PUBLIC_IPV4
APP_DOMAIN=CHANGE_ME_APP_DOMAIN
MERCHANT_DOMAIN=CHANGE_ME_MERCHANT_DOMAIN
ADMIN_DOMAIN=CHANGE_ME_ADMIN_DOMAIN
API_DOMAIN=CHANGE_ME_API_DOMAIN
TLS_EMAIL=CHANGE_ME_TLS_EMAIL
VITE_API_BASE=https://CHANGE_ME_API_DOMAIN/api
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_APP_DOMAIN,https://CHANGE_ME_MERCHANT_DOMAIN,https://CHANGE_ME_ADMIN_DOMAIN

# Host-only ports used by Nginx. Do not expose these ports publicly.
API_PORT=9000
APP_PORT=8082
MERCHANT_PORT=8083
ADMIN_PORT=8084
# Loopback-only observability management ports. These must remain distinct from
# one another and from all four core host ports.
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# Build sources. Leave DEBIAN_MIRROR empty to use the image default.
PNPM_REGISTRY=https://registry.npmjs.org
DEBIAN_MIRROR=
DEBIAN_SECURITY_MIRROR=
MYSQL_IMAGE=mysql:8.4@sha256:b3b90af2a6552ae30c266fdb7d5dd55f3afb72404bb78d37fe8a23eb857fd3fb

# Local MySQL settings. For an external MySQL server set DATABASE_MODE=external,
# place the provider CA at EXTERNAL_MYSQL_SSL_CA, and replace DATABASE_URL with
# a certificate-verifying URL such as
# mysql://user:URL_ENCODED_PASSWORD@db.example.com:3306/lingdian?sslaccept=strict&sslcert=external-mysql-ca.pem
MYSQL_DATABASE=lingdian
MYSQL_USER=lingdian
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
DATABASE_URL=mysql://lingdian:CHANGE_ME_MYSQL_URL_PASSWORD@db:3306/lingdian?allowPublicKeyRetrieval=true
# External application and backup connections both verify the CA and hostname.
EXTERNAL_MYSQL_SSL_MODE=VERIFY_IDENTITY
EXTERNAL_MYSQL_SSL_CA=/etc/lingdian/external-mysql-ca.pem
BACKUP_ARCHIVE_IMAGE=busybox:1.37@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0

# API runtime
PORT=9000
API_PREFIX=api
NODE_ENV=production
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=false
STORE_MODE=single
PRIMARY_STORE_ID=CHANGE_ME_PRIMARY_STORE_ID
STORE_BOOTSTRAP_CODE=CHANGE_ME_STORE_CODE
STORE_BOOTSTRAP_NAME=CHANGE_ME_STORE_NAME
ALLOW_DEMO_SEED=false

# Authentication secrets and initial accounts
AUTH_JWT_ACCESS_SECRET=CHANGE_ME_JWT_SECRET
AUTH_REFRESH_PEPPER=CHANGE_ME_REFRESH_PEPPER
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=true
AUTH_BOOTSTRAP_SUPER_ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
AUTH_BOOTSTRAP_SUPER_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
AUTH_BOOTSTRAP_SUPER_ADMIN_PHONE=CHANGE_ME_ADMIN_PHONE
AUTH_BOOTSTRAP_MERCHANT_USERNAME=CHANGE_ME_MERCHANT_USERNAME
AUTH_BOOTSTRAP_MERCHANT_PASSWORD=CHANGE_ME_MERCHANT_PASSWORD
AUTH_BOOTSTRAP_MERCHANT_PHONE=CHANGE_ME_MERCHANT_PHONE
AUTH_BOOTSTRAP_MERCHANT_STORE_IDS=CHANGE_ME_PRIMARY_STORE_ID

# Required production identity and SMS providers
SMS_PROVIDER=webhook
SMS_WEBHOOK_URL=https://CHANGE_ME_SMS_WEBHOOK_URL
SMS_WEBHOOK_TOKEN=CHANGE_ME_SMS_WEBHOOK_TOKEN
WECHAT_APP_ID=CHANGE_ME_WECHAT_APP_ID
WECHAT_APP_SECRET=CHANGE_ME_WECHAT_APP_SECRET
WECHAT_REDIRECT_URI=https://CHANGE_ME_APP_DOMAIN/auth/wechat/callback
WECHAT_MINI_APP_ID=CHANGE_ME_WECHAT_MINI_APP_ID
WECHAT_MINI_APP_SECRET=CHANGE_ME_WECHAT_MINI_APP_SECRET
QQ_APP_ID=CHANGE_ME_QQ_APP_ID
QQ_APP_KEY=CHANGE_ME_QQ_APP_KEY
QQ_REDIRECT_URI=https://CHANGE_ME_APP_DOMAIN/auth/qq/callback
QQ_MINI_APP_ID=CHANGE_ME_QQ_MINI_APP_ID
QQ_MINI_APP_SECRET=CHANGE_ME_QQ_MINI_APP_SECRET

# Optional connectors (disabled by default)
INTEGRATION_CASHIER_ENABLED=false
INTEGRATION_CASHIER_CONNECTOR_URL=
INTEGRATION_CASHIER_SIGNING_SECRET=
INTEGRATION_RECEIPT_ENABLED=false
INTEGRATION_RECEIPT_CONNECTOR_URL=
INTEGRATION_RECEIPT_SIGNING_SECRET=
INTEGRATION_MEITUAN_ENABLED=false
INTEGRATION_MEITUAN_CONNECTOR_URL=
INTEGRATION_MEITUAN_SIGNING_SECRET=
INTEGRATION_JD_ENABLED=false
INTEGRATION_JD_CONNECTOR_URL=
INTEGRATION_JD_SIGNING_SECRET=

# Container limits and local JSON log rotation
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=1.5
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=0.5
MYSQL_MEMORY_LIMIT=2g
MYSQL_CPU_LIMIT=2.0
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5
